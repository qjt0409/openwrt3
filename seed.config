# ============================================================
# seed.config —— Lean LEDE / x86_64
# workflow 中: cp seed.config .config && make defconfig
# 依赖项由 defconfig 自动补全，此处只声明要开启的功能
# ============================================================

# ---------- 目标平台: X86_64 ----------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------- 镜像格式 (对应图片里的全套产物) ----------
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_ISO_IMAGES=y
CONFIG_VMDK_IMAGES=y
CONFIG_VDI_IMAGES=y
CONFIG_VHDX_IMAGES=y
CONFIG_VHD_IMAGES=y
CONFIG_UEFI_IMAGES=y
CONFIG_EFI_BOOT=y
CONFIG_TARGET_IMAGES_GZIP=y

# ---------- LuCI 全局中文 ----------
CONFIG_LUCI_LANG_zh_cn=y
CONFIG_LUCI_LANG_zh_Hans=y

# ---------- 基础 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lscpu=y

# ---------- passwall / passwall2 ----------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall2=y
# passwall 常用内核(依赖完整, 不阉割)
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_hysteria2=y
CONFIG_PACKAGE_tuic-client=y
CONFIG_PACKAGE_trojan-plus=y
CONFIG_PACKAGE_v2ray-core=y
CONFIG_PACKAGE_v2ray-geodata=y

# ---------- 推送类 ----------
CONFIG_PACKAGE_luci-app-serverchan=y
CONFIG_PACKAGE_luci-app-pushbot=y

# ---------- DDNS / 穿透 ----------
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-lucky=y

# ---------- OAF 行为管理 ----------
CONFIG_PACKAGE_luci-app-oaf=y

# ---------- 系统服务 ----------
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-app-mwan3helper=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-poweroff=y
CONFIG_PACKAGE_luci-app-freemem=y

# ---------- 磁盘 / 存储 ----------
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_blkid=y

# ---------- 主题 ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- iStore 商店 ----------
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-i18n-store-zh-cn=y

# ---------- Docker (菜单: 概览/容器/镜像/网络/存储卷/事件/配置) ----------
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_cgroupfs-mount=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_luci-lib-docker=y

# ---------- 网络共享 ----------
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_samba4-libs=y
CONFIG_PACKAGE_luci-app-cifs-mount=y
CONFIG_PACKAGE_nfs-kernel-server=y

# ---------- 文件列表 ----------
CONFIG_PACKAGE_luci-app-alist=y
CONFIG_PACKAGE_luci-app-openlist2=y
CONFIG_PACKAGE_luci-app-linkease=y

# ---------- 流量统计 ----------
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y

# ---------- TurboACC 网络加速 (BBR) ----------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_DNSFORWARDER=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_SHORTCUT_FE_CM=y

# ---------- IP 限速 ----------
CONFIG_PACKAGE_luci-app-eqosplus=y
CONFIG_PACKAGE_luci-app-eqos=y

# ---------- fw4 / nftables (passwall 运行环境) ----------
CONFIG_PACKAGE_fw4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-set=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-offload=y

# ---------- 常用网络工具 ----------
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_trace-cmd=y
CONFIG_PACKAGE_netdata=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-sqm=y

# ---------- 关闭不必要的声音/打印等 ----------
CONFIG_PACKAGE_kmod-sound-core=n
CONFIG_PACKAGE_luci-app-p910nd=n
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUILD_LOG=y

